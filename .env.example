# Copy to .env. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Comma-separated, empty disables auth (local only).
API_KEYS=
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]
# The personal secrets file with HF_TOKEN, needed only to download the model the first time
SECRETS_ENV_PATH=../../secrets/secrets.env

# Vector database (docker compose up -d typesense)
STORE_BACKEND=typesense
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=lens-local-typesense
TYPESENSE_COLLECTION=lens_photographs
VECTOR_SEARCH_EF=200

# The collection: images/, collection.jsonl and the index (scripts/fetch_collection.py, scripts/build_index.py)
COLLECTION_DIR=../../assets/lens
EMBEDDING_MODEL=google/embeddinggemma-2
DEVICE=cuda
INDEX_BATCH_SIZE=8

DEFAULT_RESULTS=24
MAX_RESULTS=60
FUSION_K=60
PICTURE_WEIGHT=0.8
MAX_UPLOAD_BYTES=8000000
MAX_BATCH_UPLOADS=12

# Shared rate limit (docker compose up -d redis). Empty counts per process, local only.
REDIS_URL=redis://localhost:6380/0
RATE_LIMIT_PER_MINUTE=120
