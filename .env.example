# Copy to .env. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Comma-separated, empty disables auth (local only).
API_KEYS=
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]
# The personal secrets file with GEMINI_API_KEY. Leave empty when passed directly in env.
SECRETS_ENV_PATH=

# Vector database (docker compose up -d typesense)
STORE_BACKEND=typesense
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=lens-local-typesense
TYPESENSE_COLLECTION=lens_photographs
VECTOR_SEARCH_EF=200

# The collection: images/, collection.jsonl and the index (scripts/fetch_collection.py, scripts/build_index.py)
COLLECTION_DIR=../../assets/lens
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=30
INDEX_BATCH_SIZE=10

DEFAULT_RESULTS=24
MAX_RESULTS=60
MAX_LISTED=250
MIN_PICTURE_SCORE=0.35
MAX_UPLOAD_BYTES=8000000
MAX_BATCH_UPLOADS=12

# Shared rate limit (docker compose up -d redis). Empty counts per process, local only.
REDIS_URL=redis://localhost:6380/0
RATE_LIMIT_PER_MINUTE=120
DAILY_REQUESTS_PER_CALLER=0
DAILY_REQUESTS_TOTAL=0
DAILY_UPLOADS_PER_CALLER=0
DAILY_UPLOADS_TOTAL=0
